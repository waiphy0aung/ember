<?xml version="1.0" encoding="utf-8"?>
<!--
    Ember's data never goes to Google Drive backup: flames, whys and settings stay on your phones.
    Phone-to-phone transfer (for example Samsung Smart Switch) still moves them to your new phone.
    Ember's own export is the way to keep a copy elsewhere.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
